{
  "manifest_version": 2,
  "name": "Ads Refiner Safe Link Guard",
  "description": "Blocks ads & trackers, warns about phishing links, download protection. 100% free \u2014 no API keys, no accounts, no subscriptions.",
  "version": "2.0.1",
  "applications": {
    "gecko": {
      "id": "ads-refiner@example.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "downloads",
    "notifications",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "contextMenus"
  ],
  "background": {
    "page": "src/background-firefox.html",
    "persistent": false
  },
  "browser_action": {
    "default_title": "Ads Refiner",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-api.js",
        "src/safety-browser.js",
        "src/whitelist-browser.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "src/browser-api.js",
    "src/safety-browser.js",
    "src/whitelist-browser.js",
    "src/warning.html",
    "src/warning.js",
    "src/dashboard.html",
    "src/dashboard.js",
    "src/styles.css"
  ]
}