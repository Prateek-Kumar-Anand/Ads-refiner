{
  "manifest_version": 3,
  "name": "Ads Refiner Safe Link Guard",
  "description": "Blocks common ads, warns about suspicious links, and helps manage risky downloads from inside the browser.",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "notifications",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ads Refiner",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_refiner_rules",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/browser-api.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/warning.html",
        "src/warning.js",
        "src/styles.css",
        "src/browser-api.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
