{
  "manifest_version": 3,
  "name": "Ads Refiner Safe Link Guard",
  "description": "Blocks ads & trackers, warns about phishing links, download protection. 100% free \u2014 no API keys, no accounts, no subscriptions.",
  "version": "2.0.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "downloads",
    "notifications",
    "storage",
    "tabs",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ads Refiner",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_refiner_rules",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "trackers_refiner_rules",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/crossbrowser.js",
        "src/content.js",
        "src/timetracker.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/warning.html",
        "src/warning.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "src/dashboard.html",
        "src/system-dashboard.html",
        "src/styles.css",
        "src/icons/icon16.png",
        "src/icons/icon32.png",
        "src/icons/icon48.png",
        "src/icons/icon128.png",
        "src/favicon.js",
        "src/crossbrowser.js"
      ],
      "matches": [
        "chrome-extension://*/*"
      ]
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  }
}